{
  "name": "personal-assistant",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "daytona:smoke": "node --env-file-if-exists=.env --import tsx scripts/daytona-smoke.ts",
    "daytona:files-smoke": "node --env-file-if-exists=.env --import tsx scripts/daytona-files-smoke.ts",
    "daytona:watermark-smoke": "node --env-file-if-exists=.env --import tsx scripts/daytona-watermark-smoke.ts",
    "dev:trigger": "npx trigger.dev@4.8.10 dev",
    "start": "node dist/index.js",
    "test": "hono batch tests/routes.jsonl src/app.ts --compact && node --import tsx --test tests/*.test.mjs",
    "webhook:set": "node --env-file-if-exists=.env scripts/set-webhook.mjs",
    "webhook:info": "node --env-file-if-exists=.env scripts/get-webhook.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.123",
    "@ai-sdk/otel": "^1.0.181",
    "@daytona/sdk": "^2.2.0",
    "@hono/node-server": "^2.1.3",
    "@trigger.dev/sdk": "4.8.10",
    "ai": "^7.0.181",
    "entities": "^9.0.0",
    "firecrawl": "^4.54.0",
    "hono": "^4.13.16",
    "marked": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@trigger.dev/build": "4.8.10",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
