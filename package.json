{
  "name": "personal-assistant",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "hono batch tests/webhook.jsonl tests/app.mjs --compact -e ai -e @ai-sdk/openai",
    "webhook:set": "node --env-file-if-exists=.env scripts/set-webhook.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.123",
    "@hono/node-server": "^2.1.3",
    "ai": "^7.0.181",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
