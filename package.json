{
  "name": "personal-assistant",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev:trigger": "npx trigger.dev@4.8.10 dev",
    "start": "node dist/index.js",
    "test": "hono batch tests/routes.jsonl tests/trigger-app.mjs --compact -e ai -e @ai-sdk/openai -e @trigger.dev/sdk && hono batch tests/trigger-ai.jsonl tests/trigger-app.mjs --compact -e ai -e @ai-sdk/openai -e @trigger.dev/sdk && node --import tsx --test tests/*.test.mjs",
    "webhook:set": "node --env-file-if-exists=.env scripts/set-webhook.mjs",
    "webhook:info": "node --env-file-if-exists=.env scripts/get-webhook.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.123",
    "@ai-sdk/otel": "^1.0.181",
    "@hono/node-server": "^2.1.3",
    "@trigger.dev/sdk": "4.8.10",
    "ai": "^7.0.181",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@trigger.dev/build": "4.8.10",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
